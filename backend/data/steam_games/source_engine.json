    "image": "ghcr.io/ich777/steamcmd:latest",
    "game_port": {"port": 27015, "protocol": "udp"},
    "ports": [
      {"container": 27015, "protocol": "udp"},
      {"container": 27015, "protocol": "tcp"}
    ],
    "env": {
      "UID": 99,
      "GID": 100,
      "GAME_ID": "232330",
      "GAME_NAME": "cstrike",
      "GAME_PARAMS": "-secure +maxplayers 32 +map de_dust2",
      "GAME_PORT": 27015,
      "VALIDATE": "false"
    },
    "volume": {"container": "/serverdata"}
  },
